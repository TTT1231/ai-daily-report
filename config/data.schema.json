{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./data.schema.json",
  "title": "AI Daily Report Data Package",
  "description": "AI 日报 raw 内容与 TTS 派生渲染数据共用格式。data.json 由人维护，data-generate.json 由 TTS 生成。",
  "type": "object",
  "required": ["date", "stories"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "供编辑器识别并提供 JSON 智能提示。"
    },
    "theme": {
      "enum": ["light", "dark"],
      "description": "视频视觉主题。早间发布推荐 light，晚间发布推荐 dark。"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "日报日期，格式为 YYYY-MM-DD。"
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "description": "按播放顺序排列的内容段。具体栏目名称和数量由每期日报自行决定。",
      "items": {"$ref": "#/$defs/story"}
    },
    "intro": {
      "$ref": "#/$defs/intro",
      "description": "仅出现在 data-generate.json，由 TTS 流程根据 stories 自动生成的资讯概览。"
    },
    "outro": {
      "$ref": "#/$defs/outro",
      "description": "仅出现在 data-generate.json，由 TTS 流程自动追加的固定结语。"
    },
    "introContent": {
      "type": "string",
      "minLength": 1,
      "description": "可选。自定义 intro 旁白字幕，未提供时使用默认问候语。"
    },
    "outroContent": {
      "type": "string",
      "minLength": 1,
      "description": "可选。自定义 outro 旁白字幕，未提供时使用默认结语。"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-.]*$"
    },
    "videoStartMs": {
      "type": "integer",
      "minimum": 0,
      "description": "仅出现在 data-generate.json。该 Story（或 intro/outro）在成片中的起始毫秒，由 TTS 流程按含 story 间过渡帧的时间线（与 Remotion 渲染同源）写入。评论时间戳直接读它，不再各自重算。intro 恒为 0。"
    },
    "story": {
      "type": "object",
      "required": ["id", "topTitle", "bottomTitle", "contentTitle", "tabs", "scenes"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Story 唯一 ID。"
        },
        "topTitle": {
          "type": "string",
          "minLength": 1,
          "description": "顶部时间线栏目标签。相邻同名标签会合并，整条顶部导航的总展示宽度不得超过视频宽度；排除 Intro/Outro 后，bottomTitle 数量减去顶部相邻分段数不得超过 2。"
        },
        "bottomTitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:…|\\.\\.\\.)).*$",
          "description": "底部 Story 时间线语义短标签，必须原样完整显示，不得用省略号机械截断；优先只保留实体、产品或对象。整条底部导航的总展示宽度不得超过视频宽度。"
        },
        "contentTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "pattern": "^(?!.*(?:…|\\.\\.\\.)).*$",
          "description": "Header1 下方、Tabs 上方展示的语义完整短标题，最多 30 个字符；必须概括主体与核心事件，不得用省略号截断。"
        },
        "introTitle": {
          "type": "string",
          "minLength": 1,
          "description": "可选。Intro 资讯概览使用的来源完整标题，不主动截断；播放区主标题使用语义改写后的 contentTitle。"
        },
        "activeTab": {
          "$ref": "#/$defs/identifier",
          "description": "可选。当前 Story 整组 Tabs 中唯一高亮的 Tab ID；必须存在于当前 Story.tabs 中。省略时不高亮任何 Tab。"
        },
        "activeIntro": {
          "const": true,
          "description": "可选。将该 Story 所属 topTitle 对应的 Intro 概览卡片设为高亮；整期 stories 中最多只能有一个。"
        },
        "tabs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "description": "中部信息卡片，最少两张，最多六张。",
          "items": {"$ref": "#/$defs/tab"}
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "Story 级精简口播，通常一条、最多两条；不与 Tabs 一一对应。",
          "items": {"$ref": "#/$defs/scene"}
        },
        "videoStartMs": {"$ref": "#/$defs/videoStartMs"}
      }
    },
    "intro": {
      "type": "object",
      "required": ["id", "topTitle", "bottomTitle", "contentTitle", "tabs", "scenes"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "intro"},
        "topTitle": {"type": "string", "minLength": 1},
        "bottomTitle": {"type": "string", "minLength": 1},
        "contentTitle": {"type": "string", "minLength": 1},
        "activeTab": {
          "$ref": "#/$defs/identifier",
          "description": "由生成脚本写入，用于高亮 Intro 中唯一的栏目卡片。"
        },
        "tabs": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/introTab"}
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/scene"}
        },
        "videoStartMs": {"$ref": "#/$defs/videoStartMs"}
      }
    },
    "outro": {
      "type": "object",
      "required": ["id", "topTitle", "bottomTitle", "scenes"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "outro"},
        "topTitle": {"type": "string", "minLength": 1},
        "bottomTitle": {"type": "string", "minLength": 1},
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/scene"}
        },
        "videoStartMs": {"$ref": "#/$defs/videoStartMs"}
      }
    },
    "tab": {
      "type": "object",
      "required": ["id", "title", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Tab 唯一 ID，供 Story.activeTab 引用。"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "卡片标题。"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "卡片正文，仅支持受限 Markdown：**粗体** 与 `行内代码`。原始字符串最多 128 字符；去除 Markdown 后最多 110 个可见字符，且格式化后的视觉占用不得超过 110 单位。更多内容必须拆成额外 Tab。"
        },
        "icon": {
          "$ref": "#/$defs/iconPath",
          "description": "可选。Tab 卡片标题图标，替代 emoji 前缀。未提供时由 icon-skill 自动生成。"
        }
      }
    },
    "introTab": {
      "type": "object",
      "required": ["id", "title", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Intro 栏目概览会自动汇总多条完整新闻标题，不套用普通新闻卡的 128/110 字限制。"
        },
        "icon": {"$ref": "#/$defs/iconPath"}
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "subtitle"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Scene 唯一 ID，同时作为 TTS 音频文件映射依据。"
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "description": "建议 28 至 96 字的完整事实口播，也是 TTS 的输入文案；包含主体、事件及范围或结果。"
        },
        "overlayImg": {
          "$ref": "#/$defs/imagePath",
          "description": "可选。与当前 subtitle 同步播放的一张真实图片；同一 Story 可通过多个 Scene 依次播放多张图片。"
        },
        "overlayImgWidth": {
          "type": "integer",
          "minimum": 1,
          "description": "generated-only。overlayImg 的原始像素宽度；由 tts 构建期按文件真实像素写入 data-generate.json（Remotion 实际读取的 props），raw data.json 不落盘（rss 不写，手填也会被构建覆盖）。"
        },
        "overlayImgHeight": {
          "type": "integer",
          "minimum": 1,
          "description": "generated-only。overlayImg 的原始像素高度；由 tts 构建期按文件真实像素写入 data-generate.json（Remotion 实际读取的 props），raw data.json 不落盘（rss 不写，手填也会被构建覆盖）。"
        },
        "overlayImgScale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.6,
          "description": "可选。当前 scene 的图片手动微调倍率，只影响这一张 overlayImg；默认 1，会与入场/聚焦动画叠加。"
        },
        "audioSrc": {
          "$ref": "#/$defs/audioPath",
          "description": "仅出现在 data-generate.json，由 TTS 写入的旁白音频路径。"
        },
        "timing": {
          "$ref": "#/$defs/timing",
          "description": "仅出现在 data-generate.json，由真实音频时长生成；最终渲染前必须存在。"
        },
        "tts": {
          "$ref": "#/$defs/ttsMetadata",
          "description": "仅出现在 data-generate.json，用于记录生成参数与增量缓存信息。"
        }
      }
    },
    "timing": {
      "type": "object",
      "required": ["startMs", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Scene 在整段视频中的开始时间，单位毫秒，由 TTS 流程回写。"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Scene 的真实播放时长，单位毫秒，由 TTS 音频时长决定。"
        }
      }
    },
    "ttsMetadata": {
      "type": "object",
      "required": [
        "provider",
        "hash",
        "model",
        "voiceId",
        "speed",
        "vol",
        "pitch",
        "audioLengthMs",
        "tailPaddingMs"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "minimax",
          "description": "生成音频所使用的 TTS 服务。"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "字幕和 TTS 参数的 SHA-256，用于跳过未变化的音频。"
        },
        "model": {"type": "string", "minLength": 1},
        "voiceId": {"type": "string", "minLength": 1},
        "speed": {"type": "number", "minimum": 0.5, "maximum": 2},
        "vol": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "pitch": {"type": "number", "minimum": -12, "maximum": 12},
        "audioLengthMs": {"type": "integer", "minimum": 1},
        "tailPaddingMs": {"type": "integer", "minimum": 0}
      }
    },
    "imagePath": {
      "type": "string",
      "pattern": "^images/.+\\.(svg|png|jpe?g|webp|gif|avif)$",
      "description": "当前日报数据包中 images/ 目录下的图片路径（支持 svg/png/jpg/jpeg/webp/gif/avif）。须与 src/daily-report-data.ts 的 imagePathSchema 保持一致。"
    },
    "audioPath": {
      "type": "string",
      "pattern": "^audio/.+\\.(mp3|wav|m4a|aac|ogg)$",
      "description": "当前日报数据包中 audio/ 目录下的 TTS 音频路径。"
    },
    "iconPath": {
      "type": "string",
      "pattern": "^icons/.+\\.(svg|png)$",
      "description": "当前日报数据包中 icons/ 目录下的图标路径。"
    }
  }
}
